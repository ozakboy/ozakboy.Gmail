<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net48 吃的是主函式庫的 netstandard2.0 組建,用來驗證 ns2.0 條件編譯路徑在 .NET Framework 執行時期的行為 -->
    <TargetFrameworks>net10.0;net48</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Ozakboy.Gmail.Tests</AssemblyName>
    <RootNamespace>Ozakboy.Gmail.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>disable</Nullable>
    <!-- 測試專案放鬆 code style 強制（分析器標準只嚴格要求主函式庫） -->
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <!-- 只用來解析組信器輸出做反向驗證;主函式庫本身不依賴 MimeKit -->
    <PackageReference Include="MimeKit" Version="4.17.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ozakboy.Gmail\Ozakboy.Gmail.csproj" />
  </ItemGroup>

</Project>
