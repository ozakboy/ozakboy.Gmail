<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 目標框架：語法以 netstandard2.0 可用為準 -->
    <TargetFrameworks>netstandard2.0;netstandard2.1;net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>

    <!-- 套件基本資訊 -->
    <PackageId>Ozakboy.Gmail</PackageId>
    <AssemblyName>Ozakboy.Gmail</AssemblyName>
    <RootNamespace>Ozakboy.Gmail</RootNamespace>
    <Title>Ozakboy.Gmail — Thin async Gmail REST client + Google OAuth for .NET</Title>
    <Authors>ozakboy</Authors>
    <Company>ozakboy</Company>
    <Product>Ozakboy.Gmail</Product>
    <Copyright>Copyright © ozakboy 2026</Copyright>
    <Description>A thin, async-only client for the Gmail REST API and the Google OAuth 2.0 token endpoints, with no dependency on Google.Apis. List, read and send messages (via messages.send, so the single gmail.modify scope is enough), incremental sync with history.list, labels, trash, attachments, plus authorization URL building, code exchange, token refresh and revocation. You supply an access-token provider; the library never stores tokens. Every non-2xx response becomes a GmailApiException with the Google error reason and flags for expired history, revoked authorization and rate limiting; 429 / 5xx are retried with exponential backoff. Targets netstandard2.0, netstandard2.1, net8.0, net9.0 and net10.0.</Description>
    <PackageTags>gmail;gmail-api;google;oauth;oauth2;google-oauth;email;mail;rest;async;mimekit;history;labels;dotnet;csharp;netstandard</PackageTags>

    <!-- 版本資訊 -->
    <Version>1.0.0</Version>
    <PackageVersion>1.0.0</PackageVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>

    <!-- 專案連結 -->
    <PackageProjectUrl>https://github.com/ozakboy/ozakboy.Gmail</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ozakboy/ozakboy.Gmail</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- 授權與門面 -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>logo.png</PackageIcon>

    <!-- 建置產出 -->
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- 可重現建置與原始碼連結 -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>

    <!-- 分析器與程式碼風格 -->
    <Features>strict</Features>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <PackageReleaseNotes>
v1.0.0 — first release.

ADDED:
- GmailClient (IGmailClient): GetProfileAsync, ListMessagesAsync, GetMessageAsync, GetMessageRawAsync (MimeKit MimeMessage), ListHistoryAsync, ModifyLabelsAsync, BatchModifyLabelsAsync, TrashAsync, UntrashAsync, ReportSpamAsync, ListLabelsAsync, CreateLabelAsync, UpdateLabelAsync, DeleteLabelAsync, GetAttachmentAsync, DownloadAttachmentAsync, SendAsync (multipart upload of a MimeMessage through messages.send — the gmail.modify scope is enough, no SMTP).
- GoogleOAuthClient (IGoogleOAuthClient): BuildAuthorizationUrl, ExchangeCodeAsync, RefreshAsync, RevokeAsync; GoogleOAuthOptions.FromConfiguration; GoogleIdTokenPayload.Parse (no signature verification, for tokens received directly from Google).
- GmailApiException for every non-2xx response with StatusCode, Reason, ErrorMessage, ResponseBody and the IsUnauthorized / IsHistoryExpired / IsRateLimited / IsNotFound flags.
- Exponential backoff retry (default 3 retries from 1s, honours Retry-After) for 429, 5xx and the 403 rate-limit reasons Gmail uses, configurable through GmailClientOptions.
- Async only, ConfigureAwait(false) throughout, OperationCanceledException never wrapped; token storage is the caller's responsibility (an access-token provider delegate).

Full changelog: https://github.com/ozakboy/ozakboy.Gmail/blob/main/docs/en/changelog.md
    </PackageReleaseNotes>
  </PropertyGroup>

  <!-- 打包到 NuGet 的門面檔案（README 為英文版） -->
  <ItemGroup>
    <None Include="..\..\README.md" Pack="True" PackagePath="\" />
    <None Include="..\..\README_zh-TW.md" />
    <None Include="..\..\LICENSE" Pack="True" PackagePath="\" />
    <None Include="..\..\logo.png" Pack="True" PackagePath="\" />
  </ItemGroup>

  <!-- NuGet 相依套件 -->
  <ItemGroup>
    <PackageReference Include="MimeKit" Version="4.17.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.2" />
  </ItemGroup>

  <!-- System.Text.Json 在 netstandard 不是內建，需套件；net8.0+ 走內建版本 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0' Or '$(TargetFramework)' == 'netstandard2.1'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.300">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- 測試專案需存取 Ozakboy.Gmail.Core 的內部型別 -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Ozakboy.Gmail.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
